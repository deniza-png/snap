{
  "manifest_version": 3,
  "name": "Meet Vanish",
  "version": "1.7.2",
  "description": "Swap your Google Meet camera feed for a still image of your empty room.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "offscreen"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Meet Vanish",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-vanish": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Toggle your Meet camera between visible and vanished"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["grain-transport.js", "dust-effect.js", "gesture-rules.js", "main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}